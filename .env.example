# Copy to .env (gitignored). Only needed for the `agent` command; the MCP server itself needs no keys.

# LLM that drives `qa-mcp-server agent`: ollama (default, local, free) | anthropic | openai
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=16384
# qwen3 reasoning mode: slower, fewer degenerate outputs
OLLAMA_THINK=false

# Only for LLM_PROVIDER=anthropic (pip install "qa-mcp-server[anthropic]"); default model claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Only for LLM_PROVIDER=openai (pip install "qa-mcp-server[openai]"); set LLM_MODEL too
OPENAI_API_KEY=

# Server options (all optional)
# QA_MCP_CONFIG=qa-mcp.toml
# QA_MCP_BACKEND=adb
# QA_MCP_ADB_PATH=adb
# QA_MCP_APK_DIR=apks
# QA_MCP_ARTIFACTS_DIR=qa-mcp-artifacts
# QA_MCP_DRY_RUN=false
# QA_MCP_COMMAND_TIMEOUT_S=30
